{
  "name": "jonykru.com",
  "version": "3.11.6",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/generate-version.ts && tsx scripts/generate-og.tsx",
    "dev": "next dev",
    "prebuild": "tsx scripts/generate-version.ts && tsx scripts/generate-og.tsx",
    "build": "NODE_ENV=production next build",
    "build-analyze": "ANALYZE=true NODE_ENV=development next build",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:major": "pnpm version major --no-git-tag-version",
    "start": "npx serve out",
    "lint": "eslint . && pnpm check-flat",
    "lint:fix": "eslint . --fix",
    "check-flat": "tsx scripts/check-flat.ts",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "prepare": "husky",
    "update-credly": "tsx scripts/update-credly.ts",
    "update-medium": "tsx scripts/update-medium.ts",
    "update-oss": "tsx scripts/update-oss.ts",
    "import-medium": "tsx scripts/import-medium-export.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-og": "tsx scripts/generate-og.tsx"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@headlessui/react": "^2.2.10",
    "autoprefixer": "^10.6.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.3.5",
    "@next/eslint-plugin-next": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsc-files": "^1.1.4",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.config).{ts,tsx}": [
      "tsc-files --skipLibCheck --noEmit --project tsconfig.json"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.5.1",
  "volta": {
    "node": "24.5.0"
  }
}
