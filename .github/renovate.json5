{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Renovate replaces Dependabot here, and with it the Dependabot config and
  // the auto-merge workflow that armed its pull requests. Dependabot patches
  // the lockfile with its own logic and never runs the package manager;
  // Renovate runs pnpm itself, so what it commits is internally consistent.

  extends: [
    'config:recommended',

    // One pull request for everything that is not a major, which is what the
    // Dependabot `groups` blocks were doing.
    'group:allNonMajor',
    'schedule:weekly',

    // Hold a freshly published version back for a few days. A compromised
    // release is usually caught within hours, and nothing here is urgent
    // enough to be the one that finds out first.
    'security:minimumReleaseAgeNpm',

    // A major waits on the Dependency Dashboard until it is ticked, rather
    // than opening a pull request nobody asked for. Replaces the major-bump
    // guard that lived in the auto-merge workflow.
    ':approveMajorUpdates',

    // Peer ranges are a contract, not a dependency to keep current.
    ':disablePeerDependencies',

    // Refreshes the whole lockfile monthly, so it cannot rot on its own as
    // upstream publishes patches with no change here at all.
    ':maintainLockFilesMonthly',
  ],

  // `[INFRA] …`, not `chore(deps): …`. This repository does not use
  // Conventional Commits: commitlint.config.js pins the header to
  // `^\[(\w+)\]\s(.+)$` with an upper-case type from its own enum, and
  // `version-bump.yml` reads those brackets to decide the release bump —
  // anything that is not `[BREAKING]`, `[FEAT]` or `[UI]` is a patch, which is
  // what a dependency bump should be. Hence no `:semanticCommits` preset here,
  // unlike the sibling repositories.
  commitMessagePrefix: '[INFRA]',

  // Only `dependencies`: there is no changeset gate in this repository, so
  // there is no `skip-changeset` label for it to read.
  labels: ['dependencies'],

  // Move the declared range rather than only the lockfile, so `package.json`
  // says what is actually installed.
  rangeStrategy: 'bump',

  postUpdateOptions: ['pnpmDedupe'],

  packageRules: [
    {
      // Patch and minor merge themselves once CI is green. `platformAutomerge`
      // hands that to GitHub's own auto-merge, so it waits for the required
      // checks rather than merging blind.
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      platformAutomerge: true,
    },
  ],
}
